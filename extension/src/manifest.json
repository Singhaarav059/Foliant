{
  "manifest_version": 3,
  "name": "Open in Nopload",
  "short_name": "Nopload",
  "version": "1.0.0",
  "description": "Open PDF links and PDF tabs in Nopload's free PDF tools. The file goes from the web straight to the Nopload tab in your browser, never to a server.",
  "homepage_url": "__SITE_URL__/",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Open this PDF in Nopload",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "background": { "service_worker": "background.js" },
  "permissions": ["contextMenus", "activeTab"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "content_scripts": [
    { "matches": ["__SITE_MATCH__"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
